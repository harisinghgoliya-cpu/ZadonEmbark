---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyActionBar from '../components/StickyActionBar.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'en' | 'hi';
  altLangSlug?: string;
  schema?: object[];
  noindex?: boolean;
}

const {
  title, description, canonical, ogImage, lang = 'en',
  altLangSlug, schema = [], noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      {title} {description} {canonical} {ogImage} {lang}
      {altLangSlug} {schema} {noindex}
    />
  </head>
  <body>
    <a href="#main-content" class="sr-only skip-link">Skip to main content</a>
    <Header {lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer {lang} />
    <StickyActionBar {lang} />
    <script src="../scripts/menu.js" is:inline></script>
  </body>
</html>

<style>
  .skip-link:focus {
    position: fixed;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 9999;
    background: var(--amber-500);
    color: var(--navy-900);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }
</style>
