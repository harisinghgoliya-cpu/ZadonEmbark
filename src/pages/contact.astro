---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
---
<BaseLayout title="Contact Us" description="Get in touch with ZadonEmbark. Send an enquiry about work or study abroad — we respond within 1 working day.">

  <section class="page-hero">
    <div class="glow g1"></div><div class="glow g2"></div>
    <div class="container">
      <div class="chip">Contact</div>
      <h1>Let's Talk About <span class="text-gradient">Your Future</span></h1>
      <p>Send us an enquiry and we'll get back to you within 1 working day.</p>
    </div>
  </section>

  <section class="section light-section">
    <div class="container contact-layout">

      <!-- Left: info -->
      <aside class="contact-info">
        <h2>How to reach us</h2>

        {site.email.info && (
          <div class="contact-card">
            <div class="contact-card-icon">✉️</div>
            <div>
              <h3>Email</h3>
              <a href={`mailto:${site.email.info}`}>{site.email.info}</a>
              <p>We reply within 1 working day.</p>
            </div>
          </div>
        )}

        {site.phone && (
          <div class="contact-card">
            <div class="contact-card-icon">📞</div>
            <div>
              <h3>Phone</h3>
              <a href={`tel:${site.phone}`}>{site.phone}</a>
              {site.officeHours && <p>{site.officeHours}</p>}
            </div>
          </div>
        )}

        {site.bookingsUrl && (
          <div class="contact-card">
            <div class="contact-card-icon">📅</div>
            <div>
              <h3>Book a Free Consultation</h3>
              <a href={site.bookingsUrl} target="_blank" rel="noopener">Schedule a 30-min call →</a>
              <p>Free, no obligation.</p>
            </div>
          </div>
        )}

        {site.address && (
          <div class="contact-card">
            <div class="contact-card-icon">📍</div>
            <div>
              <h3>Office</h3>
              <p>{site.address}</p>
            </div>
          </div>
        )}

        <div class="contact-links">
          <a href="/faq/">Read our FAQ →</a>
          <a href="/fraud-awareness/">Fraud Awareness →</a>
        </div>
      </aside>

      <!-- Right: form -->
      <div class="contact-form-wrap">
        <div class="form-box">
          <h2>Send an Enquiry</h2>
          <p>Fill in the form below and our team will respond within 1 working day.</p>
          <ContactForm />
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
.page-hero { background:#060f1e;padding:var(--sp-20) 0 var(--sp-14);position:relative;overflow:hidden;text-align:center; }
.glow { position:absolute;border-radius:50%;pointer-events:none; }
.g1 { width:600px;height:400px;background:radial-gradient(ellipse,rgba(99,102,241,.45) 0%,transparent 70%);filter:blur(70px);top:-150px;left:50%;transform:translateX(-50%); }
.g2 { width:400px;height:400px;background:radial-gradient(ellipse,rgba(242,169,59,.4) 0%,transparent 70%);filter:blur(60px);bottom:-80px;right:-60px; }
.page-hero .container { position:relative;max-width:620px; }
.page-hero h1 { color:var(--white);margin:var(--sp-5) 0 var(--sp-4);font-size:var(--fs-h1); }
.page-hero p { color:rgba(255,255,255,.65);font-size:1.0625rem; }
.section { padding-block:var(--sp-20); }
.light-section { background:#fafbfd; }
.contact-layout { display:grid;grid-template-columns:380px 1fr;gap:var(--sp-12);align-items:start; }
.contact-info h2 { margin-bottom:var(--sp-8); }
.contact-card { display:flex;gap:var(--sp-4);padding:var(--sp-5);border:1px solid var(--sky-100);border-radius:var(--r-lg);background:var(--white);margin-bottom:var(--sp-4);box-shadow:0 2px 8px rgba(0,0,0,.04);transition:box-shadow .2s; }
.contact-card:hover { box-shadow:0 4px 20px rgba(0,0,0,.08); }
.contact-card-icon { font-size:1.5rem;flex-shrink:0;margin-top:2px; }
.contact-card h3 { font-size:.875rem;font-weight:600;color:var(--slate-500);text-transform:uppercase;letter-spacing:.04em;margin-bottom:var(--sp-1); }
.contact-card a { color:var(--teal-600);text-decoration:none;font-weight:600;font-size:1rem;display:block; }
.contact-card a:hover { color:var(--navy-900); }
.contact-card p { font-size:.875rem;color:var(--slate-400);margin-top:4px; }
.contact-links { display:flex;flex-direction:column;gap:var(--sp-2);margin-top:var(--sp-6); }
.contact-links a { color:var(--teal-600);text-decoration:none;font-size:.9375rem;font-weight:500; }
.contact-links a:hover { color:var(--navy-900); }
.form-box { background:var(--white);border:1px solid var(--sky-100);border-radius:var(--r-xl);padding:var(--sp-10);box-shadow:0 4px 32px rgba(0,0,0,.07); }
.form-box h2 { margin-bottom:var(--sp-2); }
.form-box p { color:var(--slate-500);margin-bottom:var(--sp-8); }
@media(max-width:1023px) { .contact-layout { grid-template-columns:1fr; } }
</style>
