---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
---
<BaseLayout title="Application Received | ZadonEmbark" description="Thank you for your application." noindex={true}>
  <section class="thankyou">
    <div class="container">
      <Icon name="check-circle" size={64} class="checkmark" />
      <h1>Application Received</h1>
      <p>Thank you for submitting your details. Our placement team will review your profile and get back to you within 1–2 working days.</p>
      <div class="actions">
        <Button href="/work-abroad/" variant="primary" size="lg">Back to Work Abroad</Button>
        <Button href="/fraud-awareness/" variant="secondary" size="lg">Fraud Awareness Guide</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.thankyou { padding: var(--sp-32) 0 var(--sp-24); text-align: center; }
.checkmark { color: var(--teal-600); display: block; margin: 0 auto var(--sp-6); }
h1 { margin-bottom: var(--sp-4); }
p { color: var(--slate-500); font-size: 1.0625rem; margin-bottom: var(--sp-10); max-width: 50ch; margin-inline: auto; line-height: 1.65; }
.actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; }
</style>
