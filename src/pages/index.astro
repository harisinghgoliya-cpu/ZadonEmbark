---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';

const waMsg = encodeURIComponent('Hi, I want to know about work/study abroad with ZadonEmbark.');
---

<BaseLayout
  title="Work & Study Abroad"
  description="ZadonEmbark helps Indian professionals and students find verified work and study opportunities internationally — with transparent fees and honest guidance."
  lang="en"
>

  <!-- ░░ HERO ░░ -->
  <section class="hero">
    <div class="hero-bg">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="glow glow-3"></div>
      <div class="glow glow-4"></div>
      <div class="mesh-grid"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="chip">International Placement Consultancy</div>
        <h1 class="hero-title">
          Your journey abroad,<br/>
          <span class="text-gradient" style="font-style:italic">handled honestly.</span>
        </h1>
        <p class="hero-sub">
          Work and study opportunities across Europe, the Gulf and beyond — fees in writing before you pay, honest advice always.
        </p>
        <div class="hero-actions">
          <Button href="/study-abroad/" variant="cta" size="lg">Explore Study Abroad</Button>
          <Button href="/work-abroad/" variant="ghost" size="lg">Find Work Abroad</Button>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">Free</span>
            <span class="stat-label">Initial Consultation</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">Written</span>
            <span class="stat-label">Fee Agreement First</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">Zero</span>
            <span class="stat-label">False Promises</span>
          </div>
        </div>
      </div>

      <div class="hero-card-wrap">
        <div class="hero-card">
          <ul class="opp-list">
            <li class="opp-item">
              <Icon name="graduation-cap" size={24} class="opp-icon" />
              <div><strong>Study Abroad</strong><p>University admissions, scholarships & visa guidance</p></div>
            </li>
            <li class="opp-item">
              <Icon name="briefcase" size={24} class="opp-icon" />
              <div><strong>Skilled Work</strong><p>International work opportunities with verified employers</p></div>
            </li>
            <li class="opp-item">
              <Icon name="wrench" size={24} class="opp-icon" />
              <div><strong>Trade & Technical</strong><p>Engineering, IT, construction, manufacturing roles</p></div>
            </li>
            <li class="opp-item">
              <Icon name="building-2" size={24} class="opp-icon" />
              <div><strong>For Employers</strong><p>International talent acquisition support</p></div>
            </li>
          </ul>
          <Button href="/contact/" variant="cta" size="md" style="width:100%;margin-top:var(--sp-4)">
            Book Free Consultation
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ WHO WE HELP ░░ -->
  <section class="section dark-section who-section">
    <div class="glow-who glow-who-1"></div>
    <div class="glow-who glow-who-2"></div>
    <div class="container" style="position:relative">
      <div class="section-header section-header--light">
        <div class="chip">Who We Serve</div>
        <h2>One platform, <span class="text-gradient">every path abroad</span></h2>
        <p class="section-sub">Whether you're a student, job seeker, employer or education partner — we have the right solution.</p>
      </div>
      <div class="cards-grid">
        {[
          { icon: 'graduation-cap', title: 'Students', desc: 'Undergraduate, postgraduate & vocational admissions at universities and colleges abroad. Scholarship guidance, language prep and visa support.', href: '/study-abroad/', color: 'amber' },
          { icon: 'briefcase', title: 'Job Seekers', desc: 'Skilled and semi-skilled work opportunities with international employers. Clear documentation support, no illegal shortcuts.', href: '/work-abroad/', color: 'teal' },
          { icon: 'building-2', title: 'Employers', desc: 'International talent acquisition support. We assist with candidate sourcing, documentation and onboarding coordination.', href: '/for-employers/', color: 'blue' },
          { icon: 'users', title: 'Partners', desc: 'Universities, colleges and licensed agencies looking to collaborate. Referral arrangements available for accredited education institutions.', href: '/partners/', color: 'purple' },
        ].map(card => (
          <a href={card.href} class={`audience-card audience-card--${card.color}`}>
            <div class="audience-icon"><Icon name={card.icon} size={32} /></div>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
            <span class="card-cta">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ HOW IT WORKS ░░ -->
  <section class="section dark-section how-section">
    <div class="glow glow-teal" style="top:50%;left:-8%;transform:translateY(-50%);"></div>
    <div class="container" style="position:relative;">
      <div class="section-header section-header--light">
        <div class="chip">Simple Process</div>
        <h2>From enquiry to departure — <span class="text-gradient">we handle it all</span></h2>
      </div>
      <div class="process-steps">
        {[
          { n: '01', title: 'Free Consultation', body: 'Tell us your goals. Our counsellors assess your profile, eligibility and best-fit options — at no cost.' },
          { n: '02', title: 'Personalised Roadmap', body: 'You get a clear plan: which countries, roles or institutions fit you, with every cost itemised upfront.' },
          { n: '03', title: 'Application & Docs', body: 'We prepare and submit your application, handle documentation and liaise with employers or institutions.' },
          { n: '04', title: 'Visa & Departure', body: 'From visa appointment guidance to pre-departure briefing — you land prepared and confident.' },
        ].map(step => (
          <div class="glass-card process-card">
            <span class="process-num">{step.n}</span>
            <h3 style="color:var(--white)">{step.title}</h3>
            <p style="color:rgba(255,255,255,.65);font-size:.9rem;margin-top:var(--sp-2)">{step.body}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:var(--sp-12)">
        <Button href="/how-it-works/" variant="ghost" size="lg">See Full Process</Button>
      </div>
    </div>
  </section>

  <!-- ░░ DESTINATIONS ░░ -->
  <section class="section dark-section dest-section">
    <div class="glow-dest glow-dest-1"></div>
    <div class="glow-dest glow-dest-2"></div>
    <div class="container" style="position:relative">
      <div class="section-header section-header--light">
        <div class="chip">Global Reach</div>
        <h2>International opportunities across <span class="text-gradient">every continent</span></h2>
        <p class="section-sub">We place candidates and students in destinations across Europe, the Middle East, Asia-Pacific and the Americas.</p>
      </div>
      <div class="destinations-grid">
        {[
          { region: 'Europe', icon: 'globe', desc: 'Strong demand for skilled workers and an established higher education system. We work with licensed partners on work and study placements.', tags: ['Skilled Work', 'Study'] },
          { region: 'Middle East', icon: 'map-pin', desc: 'Active demand across construction, healthcare, hospitality and technology sectors. We assist with documentation and employer coordination.', tags: ['Work Visas', 'Multiple Sectors'] },
          { region: 'Asia-Pacific', icon: 'globe', desc: 'Growing economies with strong international study options and post-study work pathways, subject to individual country rules.', tags: ['Study', 'Post-Study Work'] },
          { region: 'Americas', icon: 'globe', desc: 'Home to many internationally recognised universities. We provide guidance on study applications and country-specific requirements.', tags: ['Study', 'Skilled Work'] },
        ].map(d => (
          <div class="dest-card">
            <div class="dest-icon"><Icon name={d.icon} size={40} /></div>
            <h3>{d.region}</h3>
            <p>{d.desc}</p>
            <div class="dest-tags">
              {d.tags.map(t => <span class="dest-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ PROMISE ░░ -->
  <section class="section dark-section promise-section">
    <div class="glow glow-amber-soft" style="top:0;right:5%;"></div>
    <div class="container" style="position:relative;">
      <div class="section-header section-header--light">
        <div class="chip">Our Commitment</div>
        <h2>We operate with <span class="text-gradient">zero compromise</span></h2>
      </div>
      <div class="promise-grid">
        <div class="glass-card promise-card promise-card--never">
          <div class="promise-icon">✕</div>
          <h3 style="color:var(--white)">We Never</h3>
          <ul class="promise-list">
            {[
              'Guarantee visa approval or job placement',
              'Charge hidden fees or ask for advance payment without a contract',
              'Work with unverified, unlicensed employers or institutions',
              'Ask for passport, Aadhaar, PAN or bank details upfront',
              'Use machine-translated documents or forged credentials',
            ].map(i => <li>{i}</li>)}
          </ul>
        </div>
        <div class="glass-card promise-card promise-card--always">
          <div class="promise-icon">✓</div>
          <h3 style="color:var(--white)">We Always</h3>
          <ul class="promise-list">
            {[
              'Share a written, itemised fee agreement before you pay anything',
              'Verify every employer, institution and partner we recommend',
              'Give honest advice — even if it means you don\'t use our services',
              'Follow up after placement to ensure things are going well',
              'Provide a clear complaints and refund policy',
            ].map(i => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CONTACT CTA ░░ -->
  <section class="section dark-section cta-section">
    <div class="glow glow-cta-amber"></div>
    <div class="container" style="position:relative">
      <div class="cta-box glass-card">
        <div class="chip">Start Today</div>
        <h2>Ready to take the first step?</h2>
        <p>Book a free 30-minute consultation or drop us an enquiry. We'll get back to you within one working day.</p>
        <div class="cta-actions">
          {site.bookingsUrl && (
            <Button href={site.bookingsUrl} variant="cta" size="lg">Book Free Consultation</Button>
          )}
          <Button href="/contact/" variant="ghost" size="lg">View All Contact Options</Button>
        </div>
        <div class="form-wrap">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Layout helpers ── */
.section { padding-block: var(--sp-32) var(--sp-24); }
.dark-section { background: #060f1e; position: relative; overflow: hidden; }
.section-header { text-align: center; max-width: 680px; margin: 0 auto var(--sp-16); }
.section-header--light h2 { color: var(--white); }
.section-sub { color: rgba(255,255,255,.60); font-size: 1.0625rem; margin-top: var(--sp-4); line-height: 1.65; }

/* ── Hero ── */
.hero {
  background: linear-gradient(135deg, #060D16 0%, #0F1A2E 55%, #060D16 100%);
  padding-block: var(--sp-32) var(--sp-24);
  position: relative; overflow: hidden;
}
.hero-bg { position: absolute; inset: 0; pointer-events: none; }
.glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-1 { width: 700px; height: 500px; background: radial-gradient(ellipse, rgba(233,180,90,.55) 0%, rgba(233,120,30,.2) 50%, transparent 75%); filter: blur(70px); top: -200px; right: -50px; }
.glow-2 { width: 550px; height: 550px; background: radial-gradient(ellipse, rgba(13,148,136,.45) 0%, transparent 70%); filter: blur(80px); bottom: -120px; left: -60px; }
.glow-3 { width: 420px; height: 420px; background: radial-gradient(ellipse, rgba(99,102,241,.40) 0%, transparent 70%); filter: blur(70px); top: 25%; left: 20%; }
.glow-4 { width: 320px; height: 320px; background: radial-gradient(ellipse, rgba(236,72,153,.28) 0%, transparent 70%); filter: blur(60px); top: 55%; left: 48%; }
.mesh-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px);
  background-size: 60px 60px;
}
.glow-teal { width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(13,148,136,.38) 0%, transparent 70%); filter: blur(80px); position: absolute; border-radius: 50%; pointer-events: none; }
.glow-amber-soft { width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(233,180,90,.30) 0%, transparent 70%); filter: blur(80px); position: absolute; border-radius: 50%; pointer-events: none; }

.hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; position: relative; }
.hero-content { display: flex; flex-direction: column; gap: var(--sp-6); }
.hero-title { font-size: var(--fs-display); font-weight: 800; color: var(--white); line-height: 1.1; letter-spacing: -0.03em; }
.hero-sub { color: rgba(255,255,255,.65); font-size: 1.125rem; max-width: 50ch; line-height: 1.65; }
.hero-actions { display: flex; gap: var(--sp-4); flex-wrap: wrap; }
.hero-stats { display: flex; align-items: center; gap: var(--sp-6); padding-top: var(--sp-5); border-top: 1px solid rgba(255,255,255,.12); }
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat-num { font-family: var(--font-head); font-size: 1.5rem; font-weight: 800; color: var(--white); letter-spacing: -0.03em; }
.stat-label { font-size: var(--fs-xs); color: rgba(255,255,255,.50); font-weight: 500; }
.stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,.15); }

/* Hero glass card */
.hero-card-wrap { display: flex; align-items: center; justify-content: center; }
.hero-card {
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.18);
  backdrop-filter: blur(32px) saturate(180%);
  -webkit-backdrop-filter: blur(32px) saturate(180%);
  box-shadow: 0 24px 80px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.25);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  width: 100%;
}
.opp-list { list-style: none; display: flex; flex-direction: column; gap: var(--sp-4); }
.opp-item { display: flex; align-items: flex-start; gap: var(--sp-4); }
.opp-icon { flex-shrink: 0; margin-top: 2px; color: var(--gold-400); }
.opp-item strong { font-family: var(--font-head); font-size: .9375rem; font-weight: 600; color: var(--white); display: block; }
.opp-item p { font-size: var(--fs-small); color: rgba(255,255,255,.55); margin-top: 2px; }

/* ── Audience cards ── */
.who-section { }
.glow-who { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-who-1 { width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(13,148,136,.22) 0%, transparent 70%); filter: blur(100px); top: -120px; left: -80px; }
.glow-who-2 { width: 550px; height: 550px; background: radial-gradient(ellipse, rgba(233,180,90,.18) 0%, transparent 70%); filter: blur(100px); bottom: -80px; right: -80px; }
.cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.audience-card {
  display: flex; flex-direction: column; gap: var(--sp-3);
  padding: var(--sp-8); border-radius: var(--r-lg);
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  box-shadow: 0 4px 32px rgba(0,0,0,.20);
  text-decoration: none; color: inherit;
  transition: all .28s ease;
  position: relative; overflow: hidden;
}
.audience-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  opacity: 1;
}
.audience-card--amber::before { background: linear-gradient(90deg, #E9B45A, #F97316); }
.audience-card--teal::before  { background: linear-gradient(90deg, #0D9488, #22D3EE); }
.audience-card--blue::before  { background: linear-gradient(90deg, #2563EB, #818CF8); }
.audience-card--purple::before { background: linear-gradient(90deg, #7C3AED, #A855F7); }
.audience-card:hover { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.22); transform: translateY(-6px); box-shadow: 0 20px 56px rgba(0,0,0,.35); }
.audience-icon { line-height: 0; color: var(--gold-400); }
.audience-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--white); }
.audience-card p { font-size: .9rem; color: rgba(255,255,255,.60); line-height: 1.6; flex: 1; }
.card-cta { font-size: .875rem; font-weight: 600; color: var(--gold-400); margin-top: var(--sp-2); }

/* ── Process ── */
.how-section { }
.process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.process-card { padding: var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-4); }
.process-num { font-family: var(--font-head); font-size: 2.5rem; font-weight: 800; line-height: 1; background: var(--grad-amber); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

/* ── Destinations ── */
.dest-section { }
.glow-dest { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-dest-1 { width: 700px; height: 400px; background: radial-gradient(ellipse, rgba(99,102,241,.26) 0%, transparent 70%); filter: blur(90px); top: 0; right: -120px; }
.glow-dest-2 { width: 500px; height: 400px; background: radial-gradient(ellipse, rgba(13,148,136,.20) 0%, transparent 70%); filter: blur(90px); bottom: 0; left: -80px; }
.destinations-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.dest-card {
  padding: var(--sp-8); border-radius: var(--r-lg);
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.12);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  box-shadow: 0 4px 32px rgba(0,0,0,.20);
  transition: all .28s;
}
.dest-card:hover { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.22); transform: translateY(-4px); box-shadow: 0 20px 56px rgba(0,0,0,.35); }
.dest-icon { margin-bottom: var(--sp-4); color: var(--gold-400); }
.dest-card h3 { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--sp-3); color: var(--white); }
.dest-card p { font-size: .9rem; color: rgba(255,255,255,.60); line-height: 1.65; margin-bottom: var(--sp-4); }
.dest-tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
.dest-tag { font-size: 0.72rem; font-weight: 600; padding: 2px 8px; background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18); border-radius: var(--r-full); color: rgba(255,255,255,.75); }

/* ── Promise ── */
.promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-8); max-width: 900px; margin: 0 auto; }
.promise-card { padding: var(--sp-10); }
.promise-icon { font-size: 2rem; font-weight: 800; margin-bottom: var(--sp-4); }
.promise-card--never .promise-icon { color: #f87171; }
.promise-card--always .promise-icon { color: #34d399; }
.promise-list { list-style: none; display: flex; flex-direction: column; gap: var(--sp-4); margin-top: var(--sp-5); }
.promise-list li { font-size: .9375rem; color: rgba(255,255,255,.75); padding-left: var(--sp-5); position: relative; line-height: 1.55; }
.promise-card--never  .promise-list li::before { content: '—'; position: absolute; left: 0; color: #f87171; font-weight: 700; }
.promise-card--always .promise-list li::before { content: '→'; position: absolute; left: 0; color: #34d399; font-weight: 700; }

/* ── CTA section ── */
.cta-section { }
.glow-cta-amber { width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(233,180,90,.20) 0%, transparent 70%); filter: blur(90px); position: absolute; border-radius: 50%; pointer-events: none; top: 0; left: 5%; }
.cta-box { padding: var(--sp-16); text-align: center; max-width: 760px; margin: 0 auto; }
.cta-box h2 { color: var(--white); margin-bottom: var(--sp-4); }
.cta-box p { color: rgba(255,255,255,.65); font-size: 1.0625rem; margin-bottom: var(--sp-8); }
.cta-actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; margin-bottom: var(--sp-10); }
.form-wrap { text-align: left; border-top: 1px solid rgba(255,255,255,.08); padding-top: var(--sp-8); }

/* ── Responsive ── */
@media (max-width: 1023px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-card-wrap { display: none; }
  .cards-grid, .process-steps, .destinations-grid { grid-template-columns: 1fr 1fr; }
  .promise-grid { grid-template-columns: 1fr; }
}
@media (max-width: 639px) {
  .cards-grid, .process-steps, .destinations-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-wrap: wrap; gap: var(--sp-4); }
  .cta-box { padding: var(--sp-8); }
  .hero-title { font-size: clamp(2rem, 10vw, 2.75rem); }
}
</style>
