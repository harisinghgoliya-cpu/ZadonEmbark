---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';

const waMsg = encodeURIComponent('Hi, I want to know about work/study abroad with ZadonEmbark.');
---

<BaseLayout
  title="Work & Study Abroad"
  description="ZadonEmbark helps Indian professionals and students find verified work and study opportunities internationally — with transparent fees and honest guidance."
  lang="en"
  altLangSlug="/hi/"
>

  <!-- ░░ HERO ░░ -->
  <section class="hero">
    <div class="hero-bg">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="glow glow-3"></div>
      <div class="glow glow-4"></div>
      <div class="mesh-grid"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="chip">Trusted International Placement Partner</div>
        <h1 class="hero-title">
          Your Future<br/>
          <span class="text-gradient">Abroad</span> Starts Here
        </h1>
        <p class="hero-sub">
          Verified work and study opportunities across Europe, the Gulf & beyond — transparent fees, zero false promises.
        </p>
        <div class="hero-actions">
          <Button href="/study-abroad/" variant="primary" size="lg">Explore Study Abroad</Button>
          <Button href="/work-abroad/" variant="secondary" size="lg">Find Work Abroad</Button>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">10+</span>
            <span class="stat-label">Destination Countries</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">100%</span>
            <span class="stat-label">Verified Employers</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-num">Free</span>
            <span class="stat-label">Initial Consultation</span>
          </div>
        </div>
      </div>

      <div class="hero-card-wrap">
        <div class="glass-card hero-card">
          <div class="hero-card-header">
            <span class="dot dot-green"></span>
            <span class="dot dot-amber"></span>
            <span class="dot dot-red"></span>
            <span class="hero-card-title">Your Opportunity Awaits</span>
          </div>
          <ul class="opp-list">
            <li class="opp-item">
              <span class="opp-icon">🎓</span>
              <div><strong>Study Abroad</strong><p>University admissions, scholarships & visa support</p></div>
            </li>
            <li class="opp-item">
              <span class="opp-icon">💼</span>
              <div><strong>Skilled Work Visas</strong><p>Matched with verified international employers</p></div>
            </li>
            <li class="opp-item">
              <span class="opp-icon">🏥</span>
              <div><strong>Healthcare Roles</strong><p>Nurses, doctors, care workers placed abroad</p></div>
            </li>
            <li class="opp-item">
              <span class="opp-icon">🔧</span>
              <div><strong>Trade & Technical</strong><p>Engineering, IT, construction, manufacturing</p></div>
            </li>
          </ul>
          <Button href="/contact/" variant="primary" size="md" style="width:100%;margin-top:var(--sp-4)">
            Book Free Consultation
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ WHO WE HELP ░░ -->
  <section class="section light-section">
    <div class="container">
      <div class="section-header">
        <div class="chip chip--teal">Who We Serve</div>
        <h2>One platform, every path abroad</h2>
        <p class="section-sub">Whether you're a student, job seeker, employer or education partner — we have the right solution.</p>
      </div>
      <div class="cards-grid">
        {[
          { icon: '🎓', title: 'Students', desc: 'Undergraduate, postgraduate & vocational admissions at globally ranked institutions. Scholarship guidance, language prep and visa support included.', href: '/study-abroad/', color: 'amber' },
          { icon: '💼', title: 'Job Seekers', desc: 'Skilled, semi-skilled and healthcare roles with verified international employers. Genuine work permits, no illegal shortcuts.', href: '/work-abroad/', color: 'teal' },
          { icon: '🏢', title: 'Employers', desc: 'Source pre-screened Indian professionals quickly and compliantly. We handle documentation, logistics and onboarding support.', href: '/for-employers/', color: 'blue' },
          { icon: '🤝', title: 'Partners', desc: 'Institutions, training centres and local agents looking to build a referral network. Transparent revenue sharing, full support.', href: '/partners/', color: 'purple' },
        ].map(card => (
          <a href={card.href} class={`audience-card audience-card--${card.color}`}>
            <div class="audience-icon">{card.icon}</div>
            <h3>{card.title}</h3>
            <p>{card.desc}</p>
            <span class="card-cta">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ HOW IT WORKS ░░ -->
  <section class="section dark-section">
    <div class="glow glow-teal" style="top:50%;left:-10%;"></div>
    <div class="container" style="position:relative;">
      <div class="section-header section-header--light">
        <div class="chip">Simple Process</div>
        <h2 style="color:var(--white)">From enquiry to departure — <span class="text-gradient">we handle it all</span></h2>
      </div>
      <div class="process-steps">
        {[
          { n: '01', title: 'Free Consultation', body: 'Tell us your goals. Our counsellors assess your profile, eligibility and best-fit options — at no cost.' },
          { n: '02', title: 'Personalised Roadmap', body: 'You get a clear plan: which countries, roles or institutions fit you, with every cost itemised upfront.' },
          { n: '03', title: 'Application & Docs', body: 'We prepare and submit your application, handle documentation and liaise with employers or institutions.' },
          { n: '04', title: 'Visa & Departure', body: 'From visa appointment guidance to pre-departure briefing — you land prepared and confident.' },
        ].map(step => (
          <div class="glass-card process-card">
            <span class="process-num">{step.n}</span>
            <h3 style="color:var(--white)">{step.title}</h3>
            <p style="color:rgba(255,255,255,.65);font-size:.9rem;margin-top:var(--sp-2)">{step.body}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center;margin-top:var(--sp-12)">
        <Button href="/how-it-works/" variant="primary" size="lg">See Full Process</Button>
      </div>
    </div>
  </section>

  <!-- ░░ DESTINATIONS ░░ -->
  <section class="section light-section">
    <div class="container">
      <div class="section-header">
        <div class="chip">Global Reach</div>
        <h2>International opportunities across every continent</h2>
        <p class="section-sub">We place candidates and students in destinations across Europe, the Middle East, Asia-Pacific and the Americas.</p>
      </div>
      <div class="destinations-grid">
        {[
          { region: 'Europe', icon: '🇪🇺', desc: 'Skilled work visas, permanent residency pathways and world-class universities. High demand for healthcare, IT and trade roles.', tags: ['Skilled Work', 'Study', 'PR Pathways'] },
          { region: 'Middle East', icon: '🌙', desc: 'Tax-free income, rapid placement timelines and strong demand across construction, healthcare, hospitality and technology sectors.', tags: ['Work Visas', 'Tax-Free', 'Fast Placement'] },
          { region: 'Asia-Pacific', icon: '🌏', desc: 'Growing economies with strong migration programmes. Excellent study destinations with post-study work rights.', tags: ['Study', 'Post-Study Work', 'Migration'] },
          { region: 'Americas', icon: '🌎', desc: 'Top-ranked universities, diverse job markets and multiple immigration pathways for skilled professionals.', tags: ['Study', 'Skilled Work', 'Immigration'] },
        ].map(d => (
          <div class="dest-card">
            <div class="dest-icon">{d.icon}</div>
            <h3>{d.region}</h3>
            <p>{d.desc}</p>
            <div class="dest-tags">
              {d.tags.map(t => <span class="dest-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ PROMISE ░░ -->
  <section class="section dark-section promise-section">
    <div class="glow glow-amber-soft" style="top:0;right:5%;"></div>
    <div class="container" style="position:relative;">
      <div class="section-header section-header--light">
        <div class="chip">Our Commitment</div>
        <h2 style="color:var(--white)">We operate with <span class="text-gradient">zero compromise</span></h2>
      </div>
      <div class="promise-grid">
        <div class="glass-card promise-card promise-card--never">
          <div class="promise-icon">✕</div>
          <h3 style="color:var(--white)">We Never</h3>
          <ul class="promise-list">
            {[
              'Guarantee visa approval or job placement',
              'Charge hidden fees or ask for advance payment without a contract',
              'Work with unverified, unlicensed employers or institutions',
              'Ask for passport, Aadhaar, PAN or bank details upfront',
              'Use machine-translated documents or forged credentials',
            ].map(i => <li>{i}</li>)}
          </ul>
        </div>
        <div class="glass-card promise-card promise-card--always">
          <div class="promise-icon">✓</div>
          <h3 style="color:var(--white)">We Always</h3>
          <ul class="promise-list">
            {[
              'Share a written, itemised fee agreement before you pay anything',
              'Verify every employer, institution and partner we recommend',
              'Give honest advice — even if it means you don\'t use our services',
              'Follow up after placement to ensure things are going well',
              'Provide a clear complaints and refund policy',
            ].map(i => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CONTACT CTA ░░ -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-box glass-card">
        <div class="chip">Start Today</div>
        <h2>Ready to take the first step?</h2>
        <p>Book a free 30-minute consultation or drop us an enquiry. We'll get back to you within one working day.</p>
        <div class="cta-actions">
          {site.bookingsUrl && (
            <Button href={site.bookingsUrl} variant="primary" size="lg">Book Free Consultation</Button>
          )}
          <Button href="/contact/" variant="secondary" size="lg">View All Contact Options</Button>
        </div>
        <div class="form-wrap">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Layout helpers ── */
.section { padding-block: var(--sp-32) var(--sp-24); }
.light-section { background: #eef2f7; }
.dark-section { background: #060f1e; position: relative; overflow: hidden; }
.section-header { text-align: center; max-width: 680px; margin: 0 auto var(--sp-16); }
.section-header--light h2 { color: var(--white); }
.section-sub { color: var(--slate-500); font-size: 1.0625rem; margin-top: var(--sp-4); line-height: 1.65; }

/* ── Hero ── */
.hero { background: #060f1e; padding-block: var(--sp-32) var(--sp-24); position: relative; overflow: hidden; }
.hero-bg { position: absolute; inset: 0; pointer-events: none; }

/* Vivid glows — MUST be colorful so blur has something to show */
.glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-1 { width: 700px; height: 500px; background: radial-gradient(ellipse, rgba(242,169,59,.55) 0%, rgba(242,120,30,.2) 50%, transparent 75%); filter: blur(60px); top: -180px; left: 50%; transform: translateX(-30%); }
.glow-2 { width: 500px; height: 500px; background: radial-gradient(ellipse, rgba(18,122,110,.5) 0%, transparent 70%); filter: blur(70px); bottom: -100px; right: -100px; }
.glow-3 { width: 400px; height: 400px; background: radial-gradient(ellipse, rgba(99,102,241,.45) 0%, transparent 70%); filter: blur(60px); top: 20%; left: -80px; }
.glow-4 { width: 300px; height: 300px; background: radial-gradient(ellipse, rgba(236,72,153,.35) 0%, transparent 70%); filter: blur(50px); top: 60%; left: 40%; }

/* Subtle mesh grid overlay */
.mesh-grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 60px 60px;
}

.glow-teal { width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(18,122,110,.45) 0%, transparent 70%); filter: blur(70px); position: absolute; border-radius: 50%; pointer-events: none; }
.glow-amber-soft { width: 600px; height: 600px; background: radial-gradient(ellipse, rgba(242,169,59,.4) 0%, transparent 70%); filter: blur(70px); position: absolute; border-radius: 50%; pointer-events: none; }

.hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-16); align-items: center; position: relative; }
.hero-content { display: flex; flex-direction: column; gap: var(--sp-6); }
.hero-title { font-size: var(--fs-display); font-weight: 800; color: var(--white); line-height: 1.1; letter-spacing: -0.03em; }
.hero-sub { color: rgba(255,255,255,.65); font-size: 1.125rem; max-width: 50ch; line-height: 1.65; }
.hero-actions { display: flex; gap: var(--sp-4); flex-wrap: wrap; }
.hero-stats { display: flex; align-items: center; gap: var(--sp-6); padding-top: var(--sp-4); border-top: 1px solid rgba(255,255,255,.1); }
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat-num { font-family: var(--font-head); font-size: 1.5rem; font-weight: 800; color: var(--white); letter-spacing: -0.03em; }
.stat-label { font-size: var(--fs-xs); color: rgba(255,255,255,.5); font-weight: 500; }
.stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,.12); }

/* Hero floating card */
.hero-card-wrap { display: flex; align-items: center; justify-content: center; }
.hero-card { padding: var(--sp-6); width: 100%; }
.hero-card-header { display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-6); }
.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot-green  { background: #34d399; }
.dot-amber  { background: var(--amber-500); }
.dot-red    { background: #f87171; }
.hero-card-title { flex: 1; text-align: center; color: rgba(255,255,255,.5); font-size: var(--fs-xs); font-weight: 500; letter-spacing: 0.04em; }
.opp-list { list-style: none; display: flex; flex-direction: column; gap: var(--sp-4); }
.opp-item { display: flex; align-items: flex-start; gap: var(--sp-4); }
.opp-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }
.opp-item strong { font-family: var(--font-head); font-size: .9375rem; font-weight: 600; color: var(--white); display: block; }
.opp-item p { font-size: var(--fs-small); color: rgba(255,255,255,.55); margin-top: 2px; }

/* ── Audience cards ── */
.cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.audience-card {
  display: flex; flex-direction: column; gap: var(--sp-3);
  padding: var(--sp-8); border-radius: var(--r-lg);
  border: 1px solid var(--sky-100);
  background: var(--white); text-decoration: none; color: inherit;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
  transition: all .25s ease;
  position: relative; overflow: hidden;
}
.audience-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  opacity: 0; transition: opacity .25s;
}
.audience-card--amber::before { background: var(--grad-amber); }
.audience-card--teal::before  { background: var(--grad-teal); }
.audience-card--blue::before  { background: var(--grad-blue); }
.audience-card--purple::before { background: linear-gradient(135deg,#7c3aed,#a855f7); }
.audience-card:hover { transform: translateY(-5px); box-shadow: 0 16px 48px rgba(0,0,0,.10); }
.audience-card:hover::before { opacity: 1; }
.audience-icon { font-size: 2rem; }
.audience-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--ink-900); }
.audience-card p { font-size: .9rem; color: var(--slate-500); line-height: 1.6; flex: 1; }
.card-cta { font-size: .875rem; font-weight: 600; color: var(--teal-600); margin-top: var(--sp-2); }

/* ── Process ── */
.process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.process-card { padding: var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-4); }
.process-num { font-family: var(--font-head); font-size: 2.5rem; font-weight: 800; line-height: 1; background: var(--grad-amber); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

/* ── Destinations ── */
.destinations-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); }
.dest-card {
  padding: var(--sp-8); border-radius: var(--r-lg);
  border: 1px solid var(--sky-100); background: var(--white);
  box-shadow: 0 2px 12px rgba(0,0,0,.04);
  transition: all .25s;
}
.dest-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(0,0,0,.09); }
.dest-icon { font-size: 2.5rem; margin-bottom: var(--sp-4); }
.dest-card h3 { font-size: 1.125rem; font-weight: 700; margin-bottom: var(--sp-3); }
.dest-card p { font-size: .9rem; color: var(--slate-500); line-height: 1.65; margin-bottom: var(--sp-4); }
.dest-tags { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
.dest-tag {
  font-size: 0.72rem; font-weight: 600; padding: 2px 8px;
  background: var(--sky-50); border: 1px solid var(--sky-100);
  border-radius: var(--r-full); color: var(--navy-700);
}

/* ── Promise ── */
.promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-8); max-width: 900px; margin: 0 auto; }
.promise-card { padding: var(--sp-10); }
.promise-icon { font-size: 2rem; font-weight: 800; margin-bottom: var(--sp-4); }
.promise-card--never .promise-icon { color: #f87171; }
.promise-card--always .promise-icon { color: #34d399; }
.promise-list { list-style: none; display: flex; flex-direction: column; gap: var(--sp-4); margin-top: var(--sp-5); }
.promise-list li { font-size: .9375rem; color: rgba(255,255,255,.75); padding-left: var(--sp-5); position: relative; line-height: 1.55; }
.promise-card--never  .promise-list li::before { content: '—'; position: absolute; left: 0; color: #f87171; font-weight: 700; }
.promise-card--always .promise-list li::before { content: '→'; position: absolute; left: 0; color: #34d399; font-weight: 700; }

/* ── CTA section ── */
.cta-section { background: var(--sky-50); }
.cta-box {
  background: var(--grad-bg) !important;
  border: 1px solid rgba(255,255,255,.1) !important;
  padding: var(--sp-16);
  text-align: center; max-width: 760px; margin: 0 auto;
}
.cta-box h2 { color: var(--white); margin-bottom: var(--sp-4); }
.cta-box p { color: rgba(255,255,255,.65); font-size: 1.0625rem; margin-bottom: var(--sp-8); }
.cta-actions { display: flex; gap: var(--sp-4); justify-content: center; flex-wrap: wrap; margin-bottom: var(--sp-10); }
.form-wrap { text-align: left; border-top: 1px solid rgba(255,255,255,.08); padding-top: var(--sp-8); }

/* ── Responsive ── */
@media (max-width: 1023px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-card-wrap { display: none; }
  .cards-grid, .process-steps, .destinations-grid { grid-template-columns: 1fr 1fr; }
  .promise-grid { grid-template-columns: 1fr; }
}
@media (max-width: 639px) {
  .cards-grid, .process-steps, .destinations-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-wrap: wrap; gap: var(--sp-4); }
  .cta-box { padding: var(--sp-8); }
  .hero-title { font-size: clamp(2rem, 10vw, 2.75rem); }
}
</style>
