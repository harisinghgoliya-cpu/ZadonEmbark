---
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'cta' | 'whatsapp';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', type = 'button', class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  {...rest}
>
  <slot />
</Tag>

<style>
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  font-family: var(--font-head);
  font-weight: 600;
  letter-spacing: -0.01em;
  border-radius: var(--r-pill);
  border: 1.5px solid transparent;
  cursor: pointer;
  text-decoration: none;
  transition: all 200ms ease;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
}

/* Primary — navy fill, white text */
.btn--primary {
  background: var(--navy-900);
  color: var(--white);
  border-color: var(--navy-900);
}
.btn--primary:hover {
  background: var(--navy-950);
  border-color: var(--navy-950);
  color: var(--white);
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(20,38,59,.22);
}

/* CTA — gold fill, navy text (primary CTA button) */
.btn--cta {
  background: var(--gold-400);
  color: var(--navy-900);
  border-color: var(--gold-400);
}
.btn--cta:hover {
  background: #d9a44e;
  border-color: #d9a44e;
  color: var(--navy-900);
  transform: translateY(-1px);
  box-shadow: var(--shadow-amber);
}

/* Secondary — navy outline */
.btn--secondary {
  background: transparent;
  border-color: var(--navy-900);
  color: var(--navy-900);
}
.btn--secondary:hover {
  background: var(--navy-900);
  color: var(--white);
  transform: translateY(-1px);
}

/* Ghost — for use on dark/navy sections */
.btn--ghost {
  background: rgba(255,255,255,.12);
  border-color: rgba(255,255,255,.25);
  color: var(--white);
}
.btn--ghost:hover {
  background: rgba(255,255,255,.20);
  border-color: rgba(255,255,255,.40);
  color: var(--white);
  transform: translateY(-1px);
}

/* WhatsApp */
.btn--whatsapp {
  background: linear-gradient(135deg, #25D366, #1aab52);
  color: var(--white);
  border-color: transparent;
}
.btn--whatsapp:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(37,211,102,.3); color: var(--white); }

/* Sizes */
.btn--sm { min-height: 36px; padding: 0 var(--sp-4); font-size: var(--fs-small); }
.btn--md { min-height: 46px; padding: 0 var(--sp-6); font-size: var(--fs-body); }
.btn--lg { min-height: 54px; padding: 0 var(--sp-8); font-size: 1.0625rem; }
</style>
