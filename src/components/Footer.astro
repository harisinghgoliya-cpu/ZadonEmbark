---
import { site } from '../config/site';
import { nav } from '../config/nav';

export interface Props { lang?: 'en' | 'hi'; }
const { lang = 'en' } = Astro.props;
const cols = nav[lang].footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo">ZadonEmbark</span>
        <p class="footer-tagline">
          {lang === 'hi'
            ? 'विदेश में काम और पढ़ाई के लिए भरोसेमंद साथी'
            : 'Your trusted partner for work and study abroad'}
        </p>
        {site.phone && <a href={`tel:${site.phone}`} class="footer-contact">{site.phone}</a>}
        {site.email.info && <a href={`mailto:${site.email.info}`} class="footer-contact">{site.email.info}</a>}
      </div>

      {cols.map(col => (
        <ul class="footer-col" role="list">
          {col.map(item => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      ))}
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {year} {site.legalName || 'ZadonEmbark'}.
        {lang === 'hi' ? 'सर्वाधिकार सुरक्षित।' : 'All rights reserved.'}
        {site.address && <span> {site.address}</span>}
      </p>

      {site.flags.showRegistration && (
        <p class="footer-registration">
          {lang === 'hi' ? 'पंजीकरण संख्या: ' : 'Registration No: '}
          <strong>— (pending)</strong>
        </p>
      )}
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--navy-900);
  color: var(--sky-100);
  padding-block: var(--space-16) var(--space-8);
  margin-top: var(--space-24);
}
.footer-top {
  display: grid;
  grid-template-columns: 2fr repeat(3, 1fr);
  gap: var(--space-8);
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.footer-logo {
  font-family: var(--font-head);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--white);
  display: block;
  margin-bottom: var(--space-3);
}
.footer-tagline { font-size: var(--fs-small); opacity: 0.75; margin-bottom: var(--space-4); }
.footer-contact { display: block; color: var(--amber-500); text-decoration: none; font-size: 0.9rem; margin-top: var(--space-1); }
.footer-col { list-style: none; }
.footer-col a {
  color: rgba(255,255,255,0.75);
  text-decoration: none;
  font-size: 0.9rem;
  display: block;
  padding-block: var(--space-1);
  transition: color 0.15s;
}
.footer-col a:hover { color: var(--white); }
.footer-bottom {
  padding-top: var(--space-8);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-4);
}
.footer-legal { font-size: var(--fs-small); opacity: 0.6; }
.footer-registration { font-size: var(--fs-small); opacity: 0.75; }
@media (max-width: 1023px) {
  .footer-top { grid-template-columns: 1fr 1fr; }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 639px) {
  .footer-top { grid-template-columns: 1fr; }
}
</style>
