---
import { site } from '../config/site';
import Button from './Button.astro';

export interface Props { lang?: 'en' | 'hi'; }
const { lang = 'en' } = Astro.props;

const navItems = lang === 'en'
  ? [
      { label: 'Study Abroad', href: '/study-abroad/' },
      { label: 'Work Abroad', href: '/work-abroad/' },
      { label: 'For Employers', href: '/for-employers/' },
      { label: 'How It Works', href: '/how-it-works/' },
      { label: 'About', href: '/about/' },
    ]
  : [
      { label: 'विदेश पढ़ाई', href: '/hi/study-abroad/' },
      { label: 'विदेश काम', href: '/hi/work-abroad/' },
      { label: 'हमारे बारे में', href: '/hi/' },
    ];

const altHref  = lang === 'en' ? '/hi/' : '/';
const altLabel = lang === 'en' ? 'हिन्दी' : 'EN';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">

    <a href={lang === 'hi' ? '/hi/' : '/'} class="logo" aria-label="ZadonEmbark">
      <span class="logo-mark">ZE</span>
      <span class="logo-name">ZadonEmbark</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list" role="list">
        {navItems.map(item => (
          <li><a href={item.href} class="nav-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={altHref} class="lang-toggle" lang={lang === 'en' ? 'hi' : 'en'}>{altLabel}</a>
      <Button href="/contact/" variant="primary" size="sm">
        {lang === 'hi' ? 'पूछताछ करें' : 'Get Started'}
      </Button>
    </div>

    <button class="burger" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul role="list">
      {navItems.map(i => (
        <li><a href={i.href} class="mob-link">{i.label}</a></li>
      ))}
      <li><a href={altHref} class="mob-link" lang={lang === 'en' ? 'hi' : 'en'}>{altLabel}</a></li>
    </ul>
    <Button href="/contact/" variant="primary" size="md" style="width:100%;margin-top:var(--sp-4)">
      {lang === 'hi' ? 'पूछताछ करें' : 'Get Started'}
    </Button>
  </div>
</header>

<style>
.site-header {
  position: sticky; top: 0; z-index: 200;
  background: rgba(10, 26, 46, 0.72);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
.header-inner { display: flex; align-items: center; gap: var(--sp-6); height: 68px; }

.logo { display: flex; align-items: center; gap: var(--sp-3); text-decoration: none; flex-shrink: 0; }
.logo-mark {
  width: 34px; height: 34px; border-radius: var(--r-sm);
  background: var(--grad-amber);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-head); font-weight: 800; font-size: 0.8rem;
  color: var(--navy-950); letter-spacing: -0.02em;
}
.logo-name { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; color: var(--white); letter-spacing: -0.02em; }

.main-nav { flex: 1; }
.nav-list { display: flex; list-style: none; gap: var(--sp-1); }
.nav-link {
  display: block; padding: var(--sp-2) var(--sp-3);
  font-size: 0.9rem; font-weight: 500; color: rgba(255,255,255,.75);
  text-decoration: none; border-radius: var(--r-sm);
  transition: color .15s, background .15s;
}
.nav-link:hover { color: var(--white); background: rgba(255,255,255,.07); }

.header-actions { display: flex; align-items: center; gap: var(--sp-3); flex-shrink: 0; }
.lang-toggle {
  font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,.55);
  text-decoration: none; padding: var(--sp-1) var(--sp-3);
  border: 1px solid rgba(255,255,255,.12); border-radius: var(--r-full);
  transition: all .15s;
}
.lang-toggle:hover { color: var(--white); border-color: rgba(255,255,255,.3); }

.burger {
  display: none; flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer;
  padding: var(--sp-2); margin-left: auto;
}
.burger span { display: block; width: 20px; height: 2px; background: var(--white); border-radius: 2px; transition: .2s; }

/* Mobile menu */
.mobile-menu {
  background: rgba(8, 20, 38, 0.97);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255,255,255,.08);
  padding: var(--sp-6);
}
.mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: var(--sp-1); }
.mob-link {
  display: block; padding: var(--sp-3) var(--sp-4); color: rgba(255,255,255,.8);
  text-decoration: none; font-weight: 500; border-radius: var(--r-sm);
  transition: background .15s, color .15s;
}
.mob-link:hover { background: rgba(255,255,255,.07); color: var(--white); }

@media (max-width: 1023px) {
  .main-nav { display: none; }
  .burger { display: flex; }
  .header-actions .btn { display: none; }
}
</style>

<script>
const burger = document.querySelector('.burger') as HTMLButtonElement | null;
const menu   = document.getElementById('mobile-menu');
if (burger && menu) {
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
  });
}
// Scroll: more opaque when scrolled
const header = document.getElementById('site-header');
if (header) {
  window.addEventListener('scroll', () => {
    header.style.background = window.scrollY > 20
      ? 'rgba(8, 20, 38, 0.95)'
      : 'rgba(10, 26, 46, 0.72)';
  }, { passive: true });
}
</script>
