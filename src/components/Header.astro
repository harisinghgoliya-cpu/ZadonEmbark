---
import { site } from '../config/site';
import Button from './Button.astro';

export interface Props { lang?: 'en' | 'hi'; }
const { lang = 'en' } = Astro.props;

const navItems = lang === 'en'
  ? [
      { label: 'Study Abroad', href: '/study-abroad/' },
      { label: 'Work Abroad', href: '/work-abroad/' },
      { label: 'For Employers', href: '/for-employers/' },
      { label: 'How It Works', href: '/how-it-works/' },
      { label: 'Fees', href: '/fees-and-transparency/' },
      { label: 'About', href: '/about/' },
    ]
  : [
      { label: 'विदेश पढ़ाई', href: '/hi/study-abroad/' },
      { label: 'विदेश काम', href: '/hi/work-abroad/' },
      { label: 'हमारे बारे में', href: '/hi/' },
    ];

---

<header class="site-header" id="site-header">
  <div class="container header-inner">

    <a href={lang === 'hi' ? '/hi/' : '/'} class="logo" aria-label="ZadonEmbark">
      <span class="logo-wordmark">
        <span class="logo-zadon">Zadon</span><span class="logo-embark">Embark</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list" role="list">
        {navItems.map(item => (
          <li><a href={item.href} class="nav-link">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <Button href="/contact/" variant="cta" size="sm">
        {lang === 'hi' ? 'पूछताछ करें' : 'Book free consultation'}
      </Button>
    </div>

    <button class="burger" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul role="list">
      {navItems.map(i => (
        <li><a href={i.href} class="mob-link">{i.label}</a></li>
      ))}
    </ul>
    <Button href="/contact/" variant="cta" size="md" style="width:100%;margin-top:var(--sp-4)">
      {lang === 'hi' ? 'पूछताछ करें' : 'Book free consultation'}
    </Button>
  </div>
</header>

<style>
.site-header {
  position: sticky; top: 0; z-index: 200;
  background: var(--navy-900);
  border-bottom: 1px solid rgba(255,255,255,.08);
  transition: background 200ms ease, box-shadow 200ms ease;
}
.site-header.is-scrolled {
  background: rgba(20,38,59,.96);
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  box-shadow: 0 2px 24px rgba(0,0,0,.18);
}
.header-inner { display: flex; align-items: center; gap: var(--sp-6); height: 68px; }

.logo { text-decoration: none; flex-shrink: 0; }
.logo-wordmark {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: -0.03em;
  line-height: 1;
  display: flex;
  align-items: baseline;
  gap: 1px;
}
.logo-zadon {
  background: linear-gradient(135deg, #E9B45A 0%, #c8891a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.logo-embark {
  color: var(--white);
  font-weight: 500;
}

.main-nav { flex: 1; }
.nav-list { display: flex; list-style: none; gap: var(--sp-1); }
.nav-link {
  display: block; padding: var(--sp-2) var(--sp-3);
  font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,.75);
  text-decoration: none; border-radius: var(--r-pill);
  transition: color .15s, background .15s;
}
.nav-link:hover { color: var(--white); background: rgba(255,255,255,.10); }

.header-actions { display: flex; align-items: center; gap: var(--sp-3); flex-shrink: 0; }

.burger {
  display: none; flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer;
  padding: var(--sp-2); margin-left: auto;
}
.burger span { display: block; width: 22px; height: 2px; background: var(--white); border-radius: 2px; transition: .2s; }

/* Mobile menu */
.mobile-menu {
  background: var(--navy-950);
  border-top: 1px solid rgba(255,255,255,.08);
  padding: var(--sp-6);
  box-shadow: 0 8px 32px rgba(0,0,0,.20);
}
.mobile-menu ul { list-style: none; display: flex; flex-direction: column; gap: var(--sp-1); }
.mob-link {
  display: block; padding: var(--sp-3) var(--sp-4); color: rgba(255,255,255,.75);
  text-decoration: none; font-weight: 500; border-radius: var(--r-pill);
  transition: background .15s, color .15s;
}
.mob-link:hover { background: rgba(255,255,255,.10); color: var(--white); }

@media (max-width: 1023px) {
  .main-nav { display: none; }
  .burger { display: flex; }
  .header-actions .btn { display: none; }
}
</style>

<script>
const burger = document.querySelector('.burger') as HTMLButtonElement | null;
const menu   = document.getElementById('mobile-menu');
if (burger && menu) {
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
  });
}
// G1 glass: add .is-scrolled after 24px (IntersectionObserver on sentinel)
const sentinel = document.createElement('div');
sentinel.style.cssText = 'position:absolute;top:24px;left:0;width:1px;height:1px;pointer-events:none';
document.body.prepend(sentinel);
const header = document.getElementById('site-header');
if (header && sentinel) {
  new IntersectionObserver(([e]) => {
    header.classList.toggle('is-scrolled', !e.isIntersecting);
  }).observe(sentinel);
}
</script>
